{
  "name": "workzen-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/index.ts",
    "build": "prisma generate --schema=prisma/schema.prisma && tsc --skipLibCheck",
    "start": "node dist/index.js",
    "db:generate": "cd .. && node_modules/.bin/prisma generate --schema=server/prisma/schema.prisma",
    "db:migrate": "cd .. && node_modules/.bin/prisma migrate dev --schema=server/prisma/schema.prisma",
    "db:seed": "ts-node-dev --transpile-only prisma/seed.ts",
    "db:studio": "cd .. && node_modules/.bin/prisma studio --schema=server/prisma/schema.prisma",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.22.0",
    "razorpay": "^2.9.4",
    "socket.io": "^4.8.1",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0"
  }
}

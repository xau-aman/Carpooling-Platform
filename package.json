{
  "name": "workzen",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n SERVER,CLIENT -c cyan,magenta \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "db:migrate": "node_modules/.bin/prisma migrate dev --schema=server/prisma/schema.prisma",
    "db:generate": "node_modules/.bin/prisma generate --schema=server/prisma/schema.prisma",
    "db:seed": "cd server && npm run db:seed",
    "db:studio": "node_modules/.bin/prisma studio --schema=server/prisma/schema.prisma"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "concurrently": "^8.2.2",
    "prisma": "^5.22.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "axios": "^1.19.0",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^7.0.2"
  }
}
